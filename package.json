{
  "name": "piano-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Piano Tutor: aplicación local de aprendizaje y composición de piano",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w frontend",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "seed": "tsx backend/scripts/generate-seed.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
